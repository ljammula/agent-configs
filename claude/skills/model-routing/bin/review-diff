#!/usr/bin/env bash
set -euo pipefail

usage() { echo "Usage: review-diff <worktree> <diff-file>" >&2; }
if [[ $# -ne 2 ]]; then usage; exit 2; fi
worktree=$1
diff_file=$2
if [[ ! -d $worktree ]]; then echo "review-diff: worktree does not exist: $worktree" >&2; exit 2; fi
worktree=$(cd "$worktree" && pwd)
mkdir -p "$(dirname "$diff_file")"
diff_file="$(cd "$(dirname "$diff_file")" && pwd)/$(basename "$diff_file")"
tmp=$(mktemp "${TMPDIR:-/tmp}/review-diff.XXXXXX")
trap 'rm -f "$tmp"' EXIT
: > "$tmp"

# Diff against the merge base, not the tip of origin/main: a branch not yet rebased would
# otherwise show main's newer commits as reversed changes.
base=$(git -C "$worktree" merge-base origin/main HEAD)

is_output_path() {
  [[ $1 == "$diff_file" || $1 == "$diff_file"/* ]]
}

while IFS= read -r -d '' file; do
  path="$worktree/$file"
  is_output_path "$path" && continue
  if [[ -L $path ]]; then
    printf '\n\nskipped: %s (symlink)\n' "$file" >> "$tmp"
  elif [[ -f $path ]] && ! grep -Iq . "$path"; then
    printf '\n\nskipped: %s (binary)\n' "$file" >> "$tmp"
  else
    if command -v rtk >/dev/null 2>&1; then
      rtk proxy git -C "$worktree" diff --no-ext-diff "$base" -- "$file" >> "$tmp"
    else
      git -C "$worktree" diff --no-ext-diff "$base" -- "$file" >> "$tmp"
    fi
  fi
done < <(git -C "$worktree" diff --name-only -z "$base")

while IFS= read -r -d '' file; do
  path="$worktree/$file"
  is_output_path "$path" && continue
  if [[ -L $path ]]; then
    printf '\n\nskipped: %s (symlink)\n' "$file" >> "$tmp"
  elif [[ -f $path ]] && ! grep -Iq . "$path"; then
    printf '\n\nskipped: %s (binary)\n' "$file" >> "$tmp"
  else
    {
      printf '\n\n===== UNTRACKED FILE: %s =====\n' "$file"
      cat "$path"
    } >> "$tmp"
  fi
done < <(git -C "$worktree" ls-files --others --exclude-standard -z)
cat "$tmp" > "$diff_file"
