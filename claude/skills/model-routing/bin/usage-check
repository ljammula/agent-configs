#!/usr/bin/env bash
set -euo pipefail

if [[ -n ${MODEL_ROUTING_USAGE_CHECK:-} ]]; then exit 0; fi
python3 - <<'PY'
import os
import re
import subprocess

fixture = os.environ.get("MODEL_ROUTING_USAGE_FILE")  # Test-only: parse captured /usage output.
if fixture:
    try:
        output = open(fixture, encoding="utf-8").read()
        returncode = 0
    except OSError:
        output = ""
        returncode = 1
else:
    env = os.environ.copy()
    env["MODEL_ROUTING_USAGE_CHECK"] = "1"
    try:
        result = subprocess.run(
            ["claude", "-p", "/usage"], stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
            env=env, timeout=20, check=False,
        )
        output = result.stdout
        returncode = result.returncode
    except (FileNotFoundError, subprocess.TimeoutExpired):
        output = ""
        returncode = 1

output = re.sub(r"\x1b\][^\x07]*(?:\x07|\x1b\\)|\x1b\[[0-?]*[ -/]*[@-~]", "", output)

match = re.search(
    r"Current week \(all models\):\s*(\d+)% used\s*[·|]\s*resets\s*([^\r\n]+)",
    output,
)
if returncode != 0 or not match:
    print("model-routing: usage unknown")
    raise SystemExit(0)

used = int(match.group(1))
mode = "ON" if used >= 84 else "OFF"
print(f"model-routing: weekly {used}% used, resets {match.group(2).strip()}; conserve mode {mode}")
PY
